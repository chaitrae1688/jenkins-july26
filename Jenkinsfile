pipeline {
    agent any
    stages {
        stage('Clone') {
            steps {
                echo 'Cloning'
            }
        } 
        stage('Scanning') {
            steps {
                echo 'Scanning the code'
            }
        }  
        stage('Build') {
            steps {
                echo 'Building the code'
            }
        } 
        stage('Deploy') {
            steps {
                echo 'Deploying the code'
            }
        } 
    }
}